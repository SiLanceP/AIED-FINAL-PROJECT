# Copy this file to .env if you want to set server-wide defaults.
# None of these are required: students can also pick a provider and paste a key
# directly in the website's "AI Settings" page, or use the built-in hints with no AI.

DEFAULT_AI_PROVIDER=gemini

# Free online providers (get a free key from the link on the AI Settings page):
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Local providers (no key needed):
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b
LMSTUDIO_BASE_URL=http://localhost:1234/v1
